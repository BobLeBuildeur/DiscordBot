# Orchestration API base URL.
# In local dev, leave empty to use the Vite proxy (see vite.config.ts).
# For production or when running against a remote server, set the full URL:
#   PUBLIC_ORCHESTRATION_API_URL=https://api.example.com
PUBLIC_ORCHESTRATION_API_URL=

# Auth service base URL (login). Leave empty in local dev to use the Vite `/auth` proxy (port 8090).
# PUBLIC_AUTH_API_URL=http://localhost:8090
PUBLIC_AUTH_API_URL=
