# Required: HS256 signing secret (use a long random string in production).
JWT_SIGNING_SECRET=change-me-to-a-long-random-secret

# Directory containing one JSON file per user (filename = SHA-256 hex of normalized username + .json).
AUTH_USERS_DIR=data/users

# JWT lifetime in days (default 30).
JWT_EXPIRES_DAYS=30

# Optional: pepper mixed into password hashing (bcrypt).
# AUTH_PASSWORD_PEPPER=

# CORS: comma-separated origins, or * for any origin (dev only).
AUTH_CORS_ORIGINS=*
